# Copie para .env.local e preencha apenas na sua máquina (npm run dev / Electron).
# Nunca publique .env.local nem o JSON de service account.

GEMINI_API_KEY=

# Público: Client ID de *aplicativo Web* (OAuth) no Google Cloud Console (Gemini GIS, opcional).
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Firebase (web). Valores públicos do app — NÃO é service account.
# No GitHub Pages: Settings → Secrets and variables → Actions → Variables.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# Opcional: mostre “Continuar com X” se o provedor Twitter/X estiver ativo no Firebase Auth.
# VITE_FIREBASE_ENABLE_X=true
