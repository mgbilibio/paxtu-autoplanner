{
  "name": "paxtu-autoplanner",
  "private": true,
  "version": "2026.9.8",
  "description": "Assistente de Planejamento e Progressão Escoteira",
  "author": "Margus - Grupo Unisselva (Cuiabá/MT)",
  "type": "module",
  "scripts": {
    "dev": "vite --mode web",
    "dev:web": "vite --mode web",
    "build": "tsc && vite build --mode web",
    "build:web": "tsc && vite build --mode web",
    "preview": "vite preview",
    "test": "node scripts/run-unit-tests.mjs",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project demo-scoutsauto \"node --experimental-transform-types --test src/services/firebase/firestore.rules.emulator.test.ts\"",
    "audit:data": "python conhecimento/tools/audit_dados_operacionais.py --fail-on-findings"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "better-sqlite3": "^12.10.0",
    "firebase": "^11.10.0",
    "minisearch": "^7.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.19",
    "electron": "^39.8.5",
    "electron-builder": "^26.0.12",
    "firebase-tools": "^14.27.0",
    "postcss": "^8.5.10",
    "rimraf": "^6.1.2",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
