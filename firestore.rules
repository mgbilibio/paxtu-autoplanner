rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0;
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return get(userPath()).data;
    }

    function knownRoles() {
      return ['Chefe de Seção', 'Assistente', 'Diretoria', 'Leitura/Auditoria', 'ADMINISTRADOR'];
    }

    function isKnownRole(data) {
      return data.keys().hasAny(['role'])
        && data.role is string
        && data.role in knownRoles();
    }

    function isActiveUser() {
      return signedIn()
        && exists(userPath())
        && userDoc().active == true
        && isKnownRole(userDoc());
    }

    function isAdmin() {
      return isActiveUser() && userDoc().isAdmin == true;
    }

    function isBoard() {
      return isActiveUser() && userDoc().role == 'Diretoria';
    }

    function isChief() {
      return isActiveUser() && userDoc().role == 'Chefe de Seção';
    }

    function isAssistant() {
      return isActiveUser() && userDoc().role == 'Assistente';
    }

    function isReadOnly() {
      return isActiveUser()
        && (userDoc().role == 'Diretoria' || userDoc().role == 'Leitura/Auditoria');
    }

    function sectionIdsOf(data) {
      return data.keys().hasAny(['sectionIds']) && data.sectionIds is list
        ? data.sectionIds
        : (data.keys().hasAny(['sectionId']) ? [data.sectionId] : []);
    }

    function hasSection(sectionId) {
      return isAdmin()
        || (isActiveUser() && sectionId in sectionIdsOf(userDoc()));
    }

    function canWriteSection(sectionId) {
      return hasSection(sectionId)
        && !isReadOnly()
        && (isAdmin() || isChief() || isAssistant());
    }

    function canHomologateSection(sectionId) {
      return hasSection(sectionId) && (isAdmin() || isChief());
    }

    function bootstrapRef() {
      return /databases/$(database)/documents/meta/bootstrap;
    }

    function settingsRef() {
      return /databases/$(database)/documents/meta/settings;
    }

    function inviteRef() {
      return /databases/$(database)/documents/invites/$(authEmail());
    }

    function allowedBootstrapUid() {
      return exists(settingsRef())
        && get(settingsRef()).data.keys().hasAny(['allowedBootstrapUid'])
        && get(settingsRef()).data.allowedBootstrapUid is string
        && get(settingsRef()).data.allowedBootstrapUid == request.auth.uid;
    }

    function isBootstrapClaim() {
      return emailVerified()
        && allowedBootstrapUid()
        && (
          !exists(bootstrapRef())
          || getAfter(bootstrapRef()).data.uid == request.auth.uid
        );
    }

    function hasActiveInvite() {
      return signedIn()
        && exists(inviteRef())
        && get(inviteRef()).data.active == true
        && get(inviteRef()).data.email == authEmail();
    }

    function inviteSectionIds() {
      return get(inviteRef()).data.keys().hasAny(['sectionIds'])
        && get(inviteRef()).data.sectionIds is list
        ? get(inviteRef()).data.sectionIds
        : [];
    }

    function invitePrivilegesMatch() {
      return request.resource.data.email == authEmail()
        && request.resource.data.role == get(inviteRef()).data.role
        && request.resource.data.isAdmin == get(inviteRef()).data.isAdmin
        && request.resource.data.active == true
        && request.resource.data.pendingApproval == false
        && request.resource.data.rejected == false
        && (
          get(inviteRef()).data.isAdmin == true
            ? request.resource.data.sectionIds.size() == 0
            : request.resource.data.sectionIds == inviteSectionIds()
        );
    }

    function emptySectionIds(data) {
      return !data.keys().hasAny(['sectionIds'])
        || (data.sectionIds is list && data.sectionIds.size() == 0);
    }

    function registrationOpen() {
      return !exists(settingsRef())
        || get(settingsRef()).data.openRegistration != false;
    }

    function isPendingSelfPayload() {
      return registrationOpen()
        && request.resource.data.email == authEmail()
        && request.resource.data.active == false
        && request.resource.data.isAdmin == false
        && request.resource.data.pendingApproval == true
        && request.resource.data.rejected == false
        && request.resource.data.role == ''
        && emptySectionIds(request.resource.data);
    }

    function isSelfAdminLock(uid) {
      return request.auth.uid == uid
        && resource.data.isAdmin == true
        && (
          request.resource.data.isAdmin != true
          || request.resource.data.active != true
        );
    }

    function isSelfActivityUpdate(uid) {
      return signedIn()
        && request.auth.uid == uid
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastAccessAt', 'lastDataChangeAt', 'recentAccesses']);
    }

    function isInviteSelfConsume(emailKey) {
      return emailVerified()
        && emailKey == authEmail()
        && resource.data.email == authEmail()
        && (
          (
            resource.data.active == true
            && request.resource.data.active == false
            && request.resource.data.consumedByUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['active', 'consumedByUid', 'consumedAt'])
          )
          || (
            resource.data.active == false
            && resource.data.consumedByUid == request.auth.uid
            && request.resource.data.consumedByUid == request.auth.uid
            && request.resource.data.active == false
            && request.resource.data.diff(resource.data).affectedKeys().size() == 0
          )
        );
    }

    match /meta/{docId} {
      allow read: if signedIn();
      allow create: if (docId == 'bootstrap'
          && isBootstrapClaim()
          && request.resource.data.uid == request.auth.uid)
        || (docId == 'settings' && isAdmin());
      allow update: if docId == 'settings' && isAdmin();
      allow delete: if false;
    }

    match /invites/{emailKey} {
      allow read: if isAdmin() || (signedIn() && emailKey == authEmail());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isInviteSelfConsume(emailKey);
    }

    match /users/{uid} {
      allow read: if isAdmin()
        || isBoard()
        || (signedIn() && request.auth.uid == uid);

      allow create: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.email == authEmail()
          && (
            isPendingSelfPayload()
            || (
              emailVerified()
              && hasActiveInvite()
              && invitePrivilegesMatch()
            )
            || (
              isBootstrapClaim()
              && request.resource.data.active == true
              && request.resource.data.isAdmin == true
              && request.resource.data.role == 'ADMINISTRADOR'
              && getAfter(bootstrapRef()).data.uid == request.auth.uid
            )
          )
        );

      allow update: if (
          isAdmin()
          && !isSelfAdminLock(uid)
        )
        || isSelfActivityUpdate(uid)
        || (
          signedIn()
          && request.auth.uid == uid
          && resource.data.active == false
          && resource.data.isAdmin == false
          && resource.data.rejected != true
          && isPendingSelfPayload()
        );

      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /groups/{groupId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /sections/{sectionId} {
      allow read: if hasSection(sectionId);
      allow create, update, delete: if isAdmin();

      match /docs/{docId} {
        allow read: if hasSection(sectionId);
        allow write: if docId.matches('homologation.*')
          ? canHomologateSection(sectionId)
          : canWriteSection(sectionId);
      }

      match /members/{memberId}/{col}/{docId} {
        allow read: if hasSection(sectionId);
        allow write: if col == 'homologation'
          ? canHomologateSection(sectionId)
          : canWriteSection(sectionId);
      }
    }
  }
}
